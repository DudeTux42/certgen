{ pkgs ? import <nixpkgs> {} }:

pkgs.mkShell {
  nativeBuildInputs = with pkgs; [
    rustup
    pkg-config
    # Die Cross-Compilation Toolchain für musl
    pkgsCross.musl64.stdenv.cc
  ];

  # Hier setzen wir die Umgebungsvariablen, damit Cargo nicht raten muss
  shellHook = ''
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER="x86_64-unknown-linux-musl-gcc"
    # Falls dein Projekt C-Abhängigkeiten hat, helfen diese Flags:
    export CC_x86_64_unknown_linux_musl="x86_64-unknown-linux-musl-gcc"
    export CXX_x86_64_unknown_linux_musl="x86_64-unknown-linux-musl-g++"
    
    echo "🦀 Rust Cross-Shell (musl) geladen!"
    echo "Nutze: cargo build --release --target x86_64-unknown-linux-musl"
  '';
}
